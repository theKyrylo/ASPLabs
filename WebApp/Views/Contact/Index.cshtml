@model List<Contact>

<h2 xmlns="http://www.w3.org/1999/html">Lista kontaktów</h2>
<table>
    <tr>
        <th>
            Nazwisko
        </th>
        <th>
            Imię
        </th>
        <th>
            Email
        </th>
        <th>
            Priorytet
        </th>
    </tr>
    @foreach(var item in @Model)
    {
    <tr>
        <td>
            @item.LastName
        </td>
        <td>
            @item.FirstName
        </td>
        <td>
            @item.Email
        </td>
        <td>
            @item.Priority
        </td>
        <td>
            <a class="btn btn-primary"
               asp-action="Edit"
               asp-controller="Contact"
               asp-route-id=@item.Id>Edytuj</a>
            <a class="btn btn-primary"
               asp-action="Details"
               asp-controller="Contact"
               asp-route-id=@item.Id>Szczegóły</a>
            <a class="btn btn-primary"
               asp-action="Delete"
               asp-controller="Contact"
               asp-route-id=@item.Id>Usuń</a>
        </td>
    </tr>
    }
</table>
